<?xml version="1.0"?>
<ovf:Envelope xml:lang="en-US" xmlns:ovf="http://www.vmware.com/schema/ovf/1/envelope" xmlns:rasd="http://schemas.dmtf.org/wbem/wscim/1/cim-schema/2/CIM_ResourceAllocationSettingData" xmlns:vssd="http://schemas.dmtf.org/wbem/wscim/1/cim-schema/2/CIM_VirtualSystemSettingData" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ovf:References>
    <ovf:File ovf:id="file1" ovf:href="old-disk1.vmdk"/>
  </ovf:References>
  <ovf:Section xsi:type="ovf:DiskSection_Type">
    <ovf:Info>List of the virtual disks used in the package</ovf:Info>
    <ovf:Disk ovf:capacity="2147483648" ovf:diskId="vmdisk1" ovf:fileRef="file1" ovf:format="http://www.vmware.com/specifications/vmdk.html#sparse"/>
  </ovf:Section>
  <ovf:Section xsi:type="ovf:NetworkSection_Type">
    <ovf:Info>Logical networks used in the package</ovf:Info>
    <ovf:Network ovf:name="NAT"/>
  </ovf:Section>
  <ovf:Content xsi:type="ovf:VirtualSystem_Type" ovf:id="Old Appliance">
    <ovf:Info>A virtual machine</ovf:Info>
    <ovf:Section xsi:type="ovf:EulaSection_Type">
      <ovf:Info>License agreement for the virtual system</ovf:Info>
      <ovf:License>Old terms.</ovf:License>
    </ovf:Section>
    <ovf:Section xsi:type="ovf:OperatingSystemSection_Type" ovf:id="36">
      <ovf:Info>The kind of installed guest operating system</ovf:Info>
      <ovf:Description>Linux26_64</ovf:Description>
    </ovf:Section>
    <ovf:Section xsi:type="ovf:VirtualHardwareSection_Type">
      <ovf:Info>Virtual hardware requirements for a virtual machine</ovf:Info>
      <ovf:System>
        <vssd:ElementName>Virtual Hardware Family</vssd:ElementName>
        <vssd:InstanceId>0</vssd:InstanceId>
        <vssd:VirtualSystemIdentifier>Old Appliance</vssd:VirtualSystemIdentifier>
        <vssd:VirtualSystemType>vmx-6</vssd:VirtualSystemType>
      </ovf:System>
      <ovf:Item>
        <rasd:Caption>2 virtual CPU</rasd:Caption>
        <rasd:InstanceId>1</rasd:InstanceId>
        <rasd:ResourceType>3</rasd:ResourceType>
        <rasd:VirtualQuantity>2</rasd:VirtualQuantity>
      </ovf:Item>
      <ovf:Item>
        <rasd:AllocationUnits>MegaBytes</rasd:AllocationUnits>
        <rasd:Caption>512 MB of memory</rasd:Caption>
        <rasd:InstanceId>2</rasd:InstanceId>
        <rasd:ResourceType>4</rasd:ResourceType>
        <rasd:VirtualQuantity>512</rasd:VirtualQuantity>
      </ovf:Item>
      <ovf:Item>
        <rasd:Address>0</rasd:Address>
        <rasd:Caption>sataController0</rasd:Caption>
        <rasd:InstanceId>3</rasd:InstanceId>
        <rasd:ResourceSubType>AHCI</rasd:ResourceSubType>
        <rasd:ResourceType>20</rasd:ResourceType>
      </ovf:Item>
      <ovf:Item>
        <rasd:AutomaticAllocation>true</rasd:AutomaticAllocation>
        <rasd:Connection>NAT</rasd:Connection>
        <rasd:InstanceId>4</rasd:InstanceId>
        <rasd:ResourceSubType>E1000</rasd:ResourceSubType>
        <rasd:ResourceType>10</rasd:ResourceType>
      </ovf:Item>
      <ovf:Item>
        <rasd:AddressOnParent>0</rasd:AddressOnParent>
        <rasd:HostResource>ovf://disk/vmdisk1</rasd:HostResource>
        <rasd:InstanceId>5</rasd:InstanceId>
        <rasd:Parent>3</rasd:Parent>
        <rasd:ResourceType>17</rasd:ResourceType>
      </ovf:Item>
    </ovf:Section>
  </ovf:Content>
</ovf:Envelope>
