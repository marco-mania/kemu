<!DOCTYPE gui SYSTEM "kpartgui.dtd">
<gui name="kemu" version="3">
  <MenuBar>
    <Menu name="file">
      <Action name="vm_new"/>
      <Action name="vm_import"/>
      <Separator/>
      <Action name="file_quit"/>
    </Menu>
    <Menu name="vm_menu">
      <text>&amp;VM</text>
      <Action name="vm_start"/>
      <Action name="vm_start_headless"/>
      <Action name="vm_reconnect"/>
      <Separator/>
      <Action name="vm_shutdown"/>
      <Action name="vm_reset"/>
      <Action name="vm_poweroff"/>
      <Action name="vm_shutdown_host_with_guest"/>
      <Separator/>
      <Action name="vm_discard_saved_state"/>
      <Separator/>
      <Action name="vm_edit"/>
      <Action name="vm_delete"/>
      <Action name="vm_clone"/>
      <Action name="vm_make_independent"/>
      <Separator/>
      <Action name="vm_usb_devices"/>
      <Separator/>
      <Action name="vm_change_iso"/>
      <Action name="vm_eject_iso"/>
      <Action name="vm_change_floppy"/>
      <Action name="vm_eject_floppy"/>
      <Separator/>
      <Action name="vm_shrink"/>
      <Action name="vm_manage_snapshots"/>
      <Action name="vm_export"/>
      <Separator/>
      <Action name="vm_show_cmd"/>
      <Action name="vm_screenshot"/>
    </Menu>
  </MenuBar>
</gui>
