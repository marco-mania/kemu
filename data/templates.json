{
  "version": 1,
  "global_qemu_defaults": {
    "use_kvm": true,
    "ram": 4096,
    "use_balloon": true,
    "use_prealloc": false,
    "cpu_model": "host",
    "cpu_cores": 2,
    "disk_size_gb": 40,
    "machine_type": "q35",
    "gpu_type": "virtio",
    "gpu_3d_acceleration": true,
    "gpu_mem": 64,
    "display_type": "dbus",
    "display_width": 1280,
    "display_height": 720,
    "audio_device": "hda",
    "disk_interface": "virtio",
    "net_card": "virtio",
    "network_mode": "passt",
    "usb_controller": "xhci",
    "pointer_device": "usb-tablet",
    "keyboard_device": "ps2",
    "use_uefi": true,
    "use_tpm": false,
    "use_secureboot": false,
    "use_localtime": false,
    "use_acpi": true
  }
}
